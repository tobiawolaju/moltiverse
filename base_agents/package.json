{
  "name": "citadel-test-agent",
  "version": "1.0.0",
  "description": "Google ADK-based autonomous agent for testing Citadel world",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx index.ts",
    "start:trader": "cross-env AGENT_INDEX=2 tsx agents/agent_trader.ts",
    "start:influencer": "cross-env AGENT_INDEX=1 tsx agents/agent_influencer.ts",
    "start:researcher": "cross-env AGENT_INDEX=3 tsx agents/agent_researcher.ts",
    "dev": "tsx --watch index.ts"
  },
  "keywords": [
    "agent",
    "google-adk",
    "citadel",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "google-it": "^1.6.4",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}